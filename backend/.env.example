# Defaults work with docker compose. For local execution, set DATABASE_URL to sqlite:///./aivs.db
DATABASE_URL=postgresql+psycopg://aivs:aivs_password@localhost:5432/aivs
REDIS_URL=redis://localhost:6379/0
GOOGLE_FACTCHECK_API_KEY=
NEWSAPI_KEY=
ANTHROPIC_API_KEY=
# Optional model switches: true downloads ML models on first use (several GB possible)
ENABLE_TRANSFORMERS=false
ENABLE_SENTENCE_TRANSFORMERS=false
TESSERACT_CMD=tesseract
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
